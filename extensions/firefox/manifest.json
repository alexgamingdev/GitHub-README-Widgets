{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_extensionName__",
  "version": "1.0.4",
  "description": "__MSG_extensionDescription__",
  "author": "@alexgamingdev",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png"
    },
    "default_title": "__MSG_extensionName__"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "interactive-readme-widgets@alexgamingdev",
      "data_collection_permissions": {
        "required": [
          "websiteContent"
        ]
      },
      "strict_min_version": "128.0"
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "vendor/blazor-wasm/*",
        "vendor/blazor-wasm/_framework/*",
        "brand-mark.svg"
      ],
      "matches": [
        "https://github.com/*"
      ]
    }
  ],
  "options_page": "index.html"
}
